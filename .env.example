IMAGE_NAME=tsshadow/lms
# TAG: 'stable' for production (default if SERVICE_NAME=lms), 'latest' for alpha (default otherwise)
TAG=latest
SERVICE_NAME=lms_alpha

# Docker Compose Variables
LMS_TAG=stable
LMS_ALPHA_TAG=latest
LMS_PORT=80
LMS_ALPHA_PORT=8080
MUSIC_PATH=/music
DOCKER_DATA_PATH=/docker

# Music Management Integration
LMS_MUMA_API_KEY=453ecd33-3cb2-4ca4-a531-1677330bbaee
LMS_MUSIC_MANAGEMENT_RATING_API_URL=https://muma-rating-service.teunschriks.nl/api/lms-event
LMS_MUSIC_MANAGEMENT_SCROBBLING_API_URL=https://muma-scrobble-service.teunschriks.nl/scrobble
LMS_MUSIC_MANAGEMENT_USER_API_URL=https://muma-user-service.teunschriks.nl/users
# LMS_MUSIC_MANAGEMENT_RATING_API_KEY=
# LMS_MUSIC_MANAGEMENT_SCROBBLING_API_KEY=
# LMS_MUSIC_MANAGEMENT_USER_API_KEY=

# Remote Deployment (optional)
# Descriptive name for the deployment target (e.g., "Production Stack")
DEPLOY_TARGET_NAME=

# Option 1: Portainer Webhook
# NOTE: Stack Webhooks are a Business Edition feature. 
# For Community Edition, use Service Webhooks or the SSH method below.
PORTAINER_WEBHOOK_URL=

# Option 2: SSH-based deployment
REMOTE_HOST=
REMOTE_USER=
REMOTE_PASS=
# Path to docker-compose.yml or its directory on the remote host
REMOTE_STACK_PATH=
