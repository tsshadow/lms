{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  "rules": {
    "no-debugger": "error",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "prefer-const": "off",
    "no-var": "error"
  }
}
